Authorization: Bearer {{TOKEN}}
Content-Type: application/json

{
  "title": "Big Apple 2026 — Spring Edition",
  "subtitle": "Modern event stack for builders (updated)",
  "coverImage": "https://res.cloudinary.com/demo/image/upload/v1700000000/sample-cover-updated.jpg",
